# Copy to .env.local for local development. NEVER put secrets here:
# every EXPO_PUBLIC_* value is compiled into the app and readable by anyone.
# SMS gateway credentials, database passwords and admin tokens belong ONLY on the server.
#
# For EAS builds, set these per environment with `eas env:create` (preview / production).

# Mobile API base URL (HTTPS required outside local development).
# PENDING backend confirmation — see BACKEND_BLOCKERS.md (B-01).
EXPO_PUBLIC_API_BASE_URL=https://eap.cecureus.com/api/mobile/v1

# Base URL where CMS image filenames (e.g. counsellor photos) are served.
# PENDING backend confirmation — see BACKEND_BLOCKERS.md (B-09).
EXPO_PUBLIC_MEDIA_BASE_URL=https://eap.cecureus.com/uploads

EXPO_PUBLIC_PRIVACY_POLICY_URL=https://cecureus.com/privacy-policy
EXPO_PUBLIC_TERMS_URL=https://cecureus.com/terms

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Development only: run the app against a built-in fake backend (no server needed).
# Login with any email, code 123456. Refused outside development; never set this for EAS builds.
EXPO_PUBLIC_DEMO_MODE=false

# Local mock-server example (Android emulator reaches the host at 10.0.2.2):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/v1
