# Copy to .env.local for local development. NEVER put secrets here:
# every EXPO_PUBLIC_* value is compiled into the app and readable by anyone.
# SMS gateway credentials, database passwords and admin tokens belong ONLY on the server.
#
# For EAS builds, set these per environment with `eas env:create` (preview / production).

# Which backend the app uses:
#   table — the app works directly on the CecureUs table API (/api/{table}/{id}; GET/POST/PUT/DELETE).
#           Tables: employee_list, doctor_list, doctor_category, booking_appointment. See docs/TABLE_BACKEND.md.
#   api   — a CecureUs server implementing docs/API_CONTRACT.md at EXPO_PUBLIC_API_BASE_URL.
EXPO_PUBLIC_BACKEND=table
EXPO_PUBLIC_TABLE_API_URL=https://eap.cecureus.com/api

# Used only when EXPO_PUBLIC_BACKEND=api (HTTPS required outside local development).
EXPO_PUBLIC_API_BASE_URL=https://eap.cecureus.com/api/mobile/v1

# OTP SMS (SMS Integra). The app generates the code and calls this URL to send it.
# Replace the five CAPITALISED values with the ones from the SMS Integra account, keep the {...} parts
# exactly as they are, then remove the leading "# " from the EXPO_PUBLIC_SMS_URL_TEMPLATE line below
# and delete the empty one under it.
#   {mobile} 10 digits · {mobile91} 91 + 10 digits · {message} URL-encoded text · {otp} the code · {date} IST date-time
# EXPO_PUBLIC_SMS_URL_TEMPLATE=https://www.smsintegra.com/api/smsapi.aspx?uid=UID&pwd=PWD&mobile={mobile91}&msg={message}&sid=SID&type=0&dtTimeNow={date}&entityid=ENTITYID&tempid=TEMPID
# Left empty in development, the code is printed in the Metro terminal instead of being sent.
# WARNING: like every EXPO_PUBLIC_* value this is compiled into the app; see docs/TABLE_BACKEND.md.
EXPO_PUBLIC_SMS_URL_TEMPLATE=
# Must match the DLT-approved template exactly; {otp} is replaced with the code.
EXPO_PUBLIC_SMS_MESSAGE=Your CecureUs verification code is {otp}. It is valid for 10 minutes. Do not share this code with anyone.

# Base URL where CMS image filenames (e.g. counsellor photos) are served.
# PENDING backend confirmation — see BACKEND_BLOCKERS.md (B-09).
EXPO_PUBLIC_MEDIA_BASE_URL=https://eap.cecureus.com/uploads

EXPO_PUBLIC_PRIVACY_POLICY_URL=https://cecureus.com/privacy-policy
EXPO_PUBLIC_TERMS_URL=https://cecureus.com/terms

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Development only: run the app against a built-in fake backend (no server needed).
# Sign in with 98765 43210, code 123456. Refused outside development; never set this for EAS builds.
EXPO_PUBLIC_DEMO_MODE=false

# Local mock-server example (Android emulator reaches the host at 10.0.2.2):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/v1
